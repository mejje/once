# Copy to .env, fill in, then run: node --env-file=.env once.mjs
# Developer mode keeps once.mjs after a successful birth. Never commit .env.
ONCE_VOICE=claude
ONCE_MODEL=sonnet
ONCE_BOT_TOKEN=xoxb-replace-me
ONCE_APP_TOKEN=xapp-replace-me
ONCE_CHANNEL=C00000000

# For an Azure AI Foundry voice: ONCE_VOICE=foundry, ONCE_MODEL=<deployment name>
# AZURE_FOUNDRY_ENDPOINT=https://<resource>.cognitiveservices.azure.com/
# AZURE_FOUNDRY_API_KEY=replace-me
